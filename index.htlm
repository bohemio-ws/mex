<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MEX - Morales Excavación | Sistema Operativo 360°</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .mex-amber { background-color: #f1b136; }
        .mex-amber-text { color: #f1b136; }
        .bg-mex-dark { background-color: #0a0a0a; }
        .sidebar-item.active { background-color: #f1b136; color: #000; font-weight: 800; border-radius: 12px; }
        .tab-content { display: none; animation: fadeIn 0.4s ease-out; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .card-shadow { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
        .machine-draw { background: linear-gradient(135deg, #ffffff 0%, #f9fafb 100%); border: 2px solid #f1b136; transition: all 0.3s ease; }
        .machine-draw:hover { border-color: #000; transform: translateY(-5px); }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #1a1a1a; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #f1b136; border-radius: 10px; }
    </style>
</head>
<body class="bg-gray-100 text-slate-900 h-screen overflow-hidden">

    <div class="flex h-full">
        <!-- BARRA LATERAL -->
        <aside class="w-80 bg-mex-dark text-white flex flex-col p-6 shadow-2xl z-50">
            <div class="mb-10 text-center">
                <div class="bg-white p-4 rounded-3xl mb-4 shadow-xl border-4 border-amber-500">
                    <div class="text-black font-black text-4xl tracking-tighter">
                        <span class="text-amber-500">M</span>E<span class="text-amber-500">X</span>
                    </div>
                </div>
                <p class="text-[10px] text-amber-500 font-black tracking-[0.3em] uppercase">Control Operativo IA</p>
            </div>

            <nav class="flex-1 space-y-2 overflow-y-auto pr-2 custom-scrollbar">
                <p class="text-[10px] text-zinc-600 font-black uppercase mb-3 px-4">Gestión Central</p>
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="sidebar-item active w-full flex items-center gap-4 px-5 py-3.5 text-sm transition-all hover:bg-zinc-800">
                    <i class="fa-solid fa-gauge-high"></i> Panel General
                </button>
                <button onclick="switchTab('staff')" id="nav-staff" class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 text-sm text-zinc-400 hover:text-white transition-all">
                    <i class="fa-solid fa-users-gear"></i> Equipo Humano
                </button>
                <button onclick="switchTab('recambios')" id="nav-recambios" class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 text-sm text-zinc-400 hover:text-white transition-all">
                    <i class="fa-solid fa-boxes-stacked"></i> Almacén Recambios
                </button>

                <p class="text-[10px] text-zinc-600 font-black uppercase mt-8 mb-3 px-4">Control de Campo</p>
                <button onclick="switchTab('ordenes')" id="nav-ordenes" class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 text-sm text-zinc-400 hover:text-white transition-all">
                    <i class="fa-solid fa-file-contract"></i> Órdenes de Trabajo
                </button>
                <button onclick="switchTab('registros')" id="nav-registros" class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 text-sm text-zinc-400 hover:text-white transition-all">
                    <i class="fa-solid fa-clock-rotate-left"></i> Registro H / KM
                </button>
            </nav>

            <div class="mt-8 p-4 bg-zinc-900 rounded-3xl border border-zinc-800">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-2xl bg-amber-500 flex items-center justify-center font-black text-black text-xs tracking-tighter">MEX</div>
                    <div class="overflow-hidden">
                        <p class="text-xs font-black truncate">Kenny García</p>
                        <p class="text-[9px] text-amber-500 font-bold uppercase tracking-widest italic">Supervisor</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="flex-1 flex flex-col h-full overflow-hidden bg-slate-50">
            <header class="h-24 bg-white border-b px-12 flex items-center justify-between shadow-sm flex-shrink-0">
                <div>
                    <h2 id="tab-title" class="text-3xl font-black uppercase text-zinc-900 tracking-tighter">Panel General</h2>
                    <p id="tab-subtitle" class="text-[11px] font-bold text-zinc-400 uppercase tracking-[0.2em]">Morales Excavación S.L. - Control Individual</p>
                </div>
                <div class="flex gap-4">
                    <button onclick="openModal()" class="bg-black text-white hover:bg-amber-500 hover:text-black font-black px-8 py-4 rounded-2xl transition-all shadow-2xl text-[11px] uppercase tracking-widest">
                        <i class="fa-solid fa-plus-circle mr-2"></i> Nuevo Parte Digital
                    </button>
                </div>
            </header>

            <div class="flex-1 overflow-y-auto p-12 custom-scrollbar">
                
                <!-- TAB: DASHBOARD -->
                <div id="tab-dashboard" class="tab-content active space-y-10">
                    <div class="grid grid-cols-4 gap-8">
                        <div class="bg-white p-8 rounded-[2.5rem] card-shadow border border-slate-100">
                            <p class="text-[10px] font-black text-zinc-400 uppercase mb-3">Maquinistas Activos</p>
                            <p class="text-5xl font-black italic">5</p>
                        </div>
                        <div class="bg-white p-8 rounded-[2.5rem] card-shadow border border-slate-100">
                            <p class="text-[10px] font-black text-zinc-400 uppercase mb-3">Camioneros Ruta</p>
                            <p class="text-5xl font-black italic">4</p>
                        </div>
                        <div class="bg-white p-8 rounded-[2.5rem] card-shadow border border-slate-100 border-l-[10px] border-amber-500">
                            <p class="text-[10px] font-black text-zinc-400 uppercase mb-3">Supervisión</p>
                            <p class="text-5xl font-black italic text-amber-500">1</p>
                        </div>
                        <div class="bg-zinc-900 p-8 rounded-[2.5rem] shadow-2xl text-white">
                            <p class="text-[10px] font-black text-amber-500 uppercase tracking-widest mb-3">Eficiencia Operativa</p>
                            <p class="text-4xl font-black italic text-green-400">ÓPTIMA</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-10">
                        <div class="bg-white rounded-[3rem] p-10 card-shadow border border-slate-100">
                            <h3 class="font-black text-xl uppercase mb-8 flex items-center gap-4"><i class="fa-solid fa-map-location-dot text-amber-500"></i> Estado de Obra Residencial</h3>
                            <div class="h-48 bg-slate-100 rounded-2xl flex items-center justify-center italic text-zinc-400">
                                <i class="fa-solid fa-satellite-dish text-4xl mr-4 text-amber-500 animate-pulse"></i>
                                [Sistema GPS Activo: 10 unidades en seguimiento]
                            </div>
                        </div>
                        <div class="bg-white rounded-[3rem] p-10 card-shadow border border-slate-100">
                            <h3 class="font-black text-xl uppercase mb-8 flex items-center gap-4"><i class="fa-solid fa-gas-pump text-amber-500"></i> Alertas de Consumo</h3>
                            <div class="space-y-4">
                                <div class="w-full bg-slate-100 h-4 rounded-full overflow-hidden"><div class="bg-amber-500 h-full w-[65%]"></div></div>
                                <p class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">Depósito Central: 65% (850L Disponibles)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB: EQUIPO HUMANO (DIBUJOS ESPECÍFICOS) -->
                <div id="tab-staff" class="tab-content">
                    <div class="flex gap-4 bg-zinc-900 p-4 rounded-3xl w-max mb-12 shadow-xl">
                        <button onclick="filterStaff('all')" class="px-8 py-2.5 rounded-2xl text-xs font-black uppercase text-amber-500">Todo el Equipo</button>
                        <button onclick="filterStaff('maquinista')" class="px-8 py-2.5 rounded-2xl text-xs font-black uppercase text-white hover:text-amber-500 transition-all">Maquinistas</button>
                        <button onclick="filterStaff('camionero')" class="px-8 py-2.5 rounded-2xl text-xs font-black uppercase text-white hover:text-amber-500 transition-all">Camioneros</button>
                        <button onclick="filterStaff('aparejador')" class="px-8 py-2.5 rounded-2xl text-xs font-black uppercase text-white hover:text-amber-500 transition-all">Aparejador</button>
                    </div>
                    <div id="staff-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-8">
                        <!-- Inyectado por JS -->
                    </div>
                </div>

                <!-- TAB: RECAMBIOS -->
                <div id="tab-recambios" class="tab-content grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <div class="bg-white p-8 rounded-[3rem] card-shadow border hover:border-amber-500 transition-all group">
                        <div class="h-44 rounded-2xl machine-draw flex flex-col items-center justify-center mb-6">
                            <i class="fa-solid fa-circle-nodes text-6xl text-amber-500 mb-2"></i>
                            <span class="text-[9px] font-bold uppercase text-zinc-400 tracking-tighter">Neumáticos</span>
                        </div>
                        <h4 class="font-black text-xl mb-1 uppercase tracking-tighter italic">Neumáticos</h4>
                        <div class="text-[10px] font-bold text-zinc-400 mb-4 border-b pb-2 flex justify-between"><span>STOCK TOTAL:</span> <span>12 UND</span></div>
                        <button class="w-full py-3 bg-black text-white rounded-xl text-[10px] font-black uppercase hover:bg-amber-500 transition-all shadow-md">Ver Inventario</button>
                    </div>
                    <div class="bg-white p-8 rounded-[3rem] card-shadow border hover:border-amber-500 transition-all group">
                        <div class="h-44 rounded-2xl machine-draw flex flex-col items-center justify-center mb-6">
                            <i class="fa-solid fa-droplet text-6xl text-amber-500 mb-2"></i>
                            <span class="text-[9px] font-bold uppercase text-zinc-400 tracking-tighter">Lubricantes</span>
                        </div>
                        <h4 class="font-black text-xl mb-1 uppercase tracking-tighter italic">Aceites / Grasa</h4>
                        <div class="text-[10px] font-bold text-red-500 mb-4 border-b pb-2 flex justify-between"><span>HIDRÁULICO 46:</span> <span>CRÍTICO</span></div>
                        <button class="w-full py-3 bg-red-600 text-white rounded-xl text-[10px] font-black uppercase hover:bg-black transition-all shadow-md">Compra Urgente</button>
                    </div>
                    <div class="bg-white p-8 rounded-[3rem] card-shadow border hover:border-amber-500 transition-all group">
                        <div class="h-44 rounded-2xl machine-draw flex flex-col items-center justify-center mb-6">
                            <i class="fa-solid fa-car-battery text-6xl text-amber-500 mb-2"></i>
                            <span class="text-[9px] font-bold uppercase text-zinc-400 tracking-tighter">Energía</span>
                        </div>
                        <h4 class="font-black text-xl mb-1 uppercase tracking-tighter italic">Baterías</h4>
                        <div class="text-[10px] font-bold text-zinc-400 mb-4 border-b pb-2 flex justify-between"><span>24V HEAVY DUTY:</span> <span>2 DISP</span></div>
                        <button class="w-full py-3 bg-black text-white rounded-xl text-[10px] font-black uppercase hover:bg-amber-500 transition-all shadow-md">Ver Taller</button>
                    </div>
                    <div class="bg-white p-8 rounded-[3rem] card-shadow border hover:border-amber-500 transition-all group">
                        <div class="h-44 rounded-2xl machine-draw flex flex-col items-center justify-center mb-6">
                            <i class="fa-solid fa-filter text-6xl text-amber-500 mb-2"></i>
                            <span class="text-[9px] font-bold uppercase text-zinc-400 tracking-tighter">Filtros</span>
                        </div>
                        <h4 class="font-black text-xl mb-1 uppercase tracking-tighter italic">Filtros</h4>
                        <div class="text-[10px] font-bold text-zinc-400 mb-4 border-b pb-2 flex justify-between"><span>FILTROS AIRE CAT:</span> <span>4 UND</span></div>
                        <button class="w-full py-3 bg-black text-white rounded-xl text-[10px] font-black uppercase hover:bg-amber-500 transition-all shadow-md">Revisiones</button>
                    </div>
                </div>

                <!-- TAB: ÓRDENES DE TRABAJO -->
                <div id="tab-ordenes" class="tab-content space-y-8">
                    <div id="ordenes-list" class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        <!-- Inyectado por JS -->
                    </div>
                </div>

                <!-- TAB: REGISTROS H/KM -->
                <div id="tab-registros" class="tab-content">
                    <div class="bg-white rounded-[3.5rem] card-shadow border overflow-hidden">
                        <table class="w-full text-left">
                            <thead class="bg-black text-amber-500">
                                <tr>
                                    <th class="px-10 py-6 text-[10px] font-black uppercase tracking-widest">Unidad / Operador</th>
                                    <th class="px-10 py-6 text-[10px] font-black uppercase tracking-widest bg-zinc-900">Lectura Inicial</th>
                                    <th class="px-10 py-6 text-[10px] font-black uppercase tracking-widest bg-zinc-900 border-l border-zinc-800">Lectura Final</th>
                                    <th class="px-10 py-6 text-[10px] font-black uppercase tracking-widest">Rendimiento Hoy</th>
                                </tr>
                            </thead>
                            <tbody id="registros-table-body" class="divide-y divide-slate-100 italic">
                                <!-- Inyectado por JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- MODAL REGISTRO -->
    <div id="modal-form" class="hidden fixed inset-0 bg-black/90 backdrop-blur-md z-[100] flex items-center justify-center p-6">
        <div class="bg-white rounded-[3.5rem] w-full max-w-2xl shadow-2xl overflow-hidden animate-in zoom-in duration-300">
            <div class="bg-black p-10 flex justify-between items-center">
                <h3 class="text-amber-500 font-black text-2xl tracking-tighter italic uppercase">Nuevo Parte MEX</h3>
                <button onclick="closeModal()" class="text-white hover:text-amber-500 transition-all"><i class="fa-solid fa-circle-xmark text-4xl"></i></button>
            </div>
            <form class="p-12 space-y-8">
                <div class="grid grid-cols-2 gap-8">
                    <div>
                        <label class="block text-[10px] font-black text-zinc-400 uppercase mb-3">Asignar Unidad</label>
                        <select class="w-full bg-slate-100 border-b-4 border-slate-200 p-4 font-black text-sm uppercase outline-none focus:border-amber-500">
                            <option>CAT 320 - Retroexcavadora</option>
                            <option>Volvo FH16 - Camión</option>
                            <option>JCB 3CX - Mixta</option>
                            <option>HAMM - Apisonadora</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-zinc-400 uppercase mb-3">Operario</label>
                        <select class="w-full bg-slate-100 border-b-4 border-slate-200 p-4 font-black text-sm uppercase outline-none focus:border-amber-500">
                            <option>Ricardo Gómez</option>
                            <option>Josele Ruíz</option>
                            <option>Luis Martínez</option>
                        </select>
                    </div>
                </div>
                <div class="bg-slate-50 p-8 rounded-[2rem] border grid grid-cols-2 gap-8">
                    <div>
                        <label class="block text-[10px] font-black text-blue-600 uppercase mb-2 italic tracking-tighter">Hora/KM Inicio</label>
                        <input type="number" step="0.01" class="w-full bg-white border rounded-xl p-4 font-black font-mono text-xl text-blue-600 outline-none shadow-inner">
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-red-600 uppercase mb-2 italic tracking-tighter">Hora/KM Cierre</label>
                        <input type="number" step="0.01" class="w-full bg-white border rounded-xl p-4 font-black font-mono text-xl text-red-600 outline-none shadow-inner">
                    </div>
                </div>
                <button type="button" onclick="alert('Parte Sincronizado Correctamente')" class="w-full bg-black text-white py-6 rounded-3xl font-black uppercase tracking-[0.3em] hover:bg-amber-500 hover:text-black transition-all shadow-xl">Sincronizar Parte</button>
            </form>
        </div>
    </div>

    <script>
        // Dibujos SVG personalizados para maquinaria MEX
        const machineIcons = {
            retro: `<svg viewBox="0 0 100 60" fill="none" stroke="currentColor" stroke-width="2.5" class="w-24 h-24 text-amber-500"><path d="M10 50h40l5-10h-35l-10 10zM50 40l10-20h20l10 10M15 50a5 5 0 100 10 5 5 0 000-10zM45 50a5 5 0 100 10 5 5 0 000-10zM80 30l10 20M90 50h10v-10h-10z" stroke-linecap="round"/></svg>`,
            mixta: `<svg viewBox="0 0 100 60" fill="none" stroke="currentColor" stroke-width="2.5" class="w-24 h-24 text-amber-500"><path d="M20 50h50l5-15h-40M15 35h15l5 10M70 50l10-20M10 35l10 15M25 50a5 5 0 100 10 5 5 0 000-10zM65 50a5 5 0 100 10 5 5 0 000-10z" stroke-linecap="round"/></svg>`,
            apisonadora: `<svg viewBox="0 0 100 60" fill="none" stroke="currentColor" stroke-width="2.5" class="w-24 h-24 text-amber-500"><path d="M10 50a15 15 0 1030 0 15 15 0 00-30 0zM40 50h40l5-15h-35M80 50a5 5 0 100 10 5 5 0 000-10z" stroke-linecap="round"/></svg>`,
            camion: `<svg viewBox="0 0 100 60" fill="none" stroke="currentColor" stroke-width="2.5" class="w-24 h-24 text-amber-500"><path d="M10 50h80v-20h-50v-10h-30v30zM25 50a5 5 0 100 10 5 5 0 000-10zM75 50a5 5 0 100 10 5 5 0 000-10z" stroke-linecap="round"/></svg>`,
            casco: `<svg viewBox="0 0 100 60" fill="none" stroke="currentColor" stroke-width="2.5" class="w-24 h-24 text-amber-500"><path d="M20 50a30 30 0 0160 0M15 50h70" stroke-linecap="round"/></svg>`
        };

        const staff = [
            // Maquinistas
            { n: "Ricardo Gómez", r: "maquinista", m: "CAT 320 - Retroexcavadora", type: "retro", ot: "Movimiento de tierras - Sector A", status: "En curso" },
            { n: "Josele Ruíz", r: "maquinista", m: "JCB 3CX - Mixta", type: "mixta", ot: "Zanjeo saneamiento vial", status: "En curso" },
            { n: "Antonio Ruíz", r: "maquinista", m: "HAMM - Apisonadora", type: "apisonadora", ot: "Compactado de bases Sector B", status: "En curso" },
            { n: "Manolo Ortiz", r: "maquinista", m: "Motoniveladora G1", type: "mixta", ot: "Perfilado de caminos internos", status: "En curso" },
            { n: "Paco Jiménez", r: "maquinista", m: "Bulldozer D6", type: "retro", ot: "Empuje de zahorra", status: "Parada preventiva" },
            // Camioneros
            { n: "Luis Martínez", r: "camionero", m: "Volvo FH16 (C1)", type: "camion", ot: "Transporte áridos Tarancón", status: "En ruta" },
            { n: "Miguel Serna", r: "camionero", m: "Dúmper Mercedes", type: "camion", ot: "Carga interna de obra", status: "Cargando" },
            { n: "Carlos Soria", r: "camionero", m: "Bañera Scania", type: "camion", ot: "Retirada escombros vertedero", status: "En ruta" },
            { n: "Fernando Rey", r: "camionero", m: "Camión Grúa", type: "camion", ot: "Traslado casetas de obra", status: "Disponible" },
            // Aparejador
            { n: "David Morales", r: "aparejador", m: "Dirección de Obra", type: "casco", ot: "Replanteo y control de cotas", status: "Supervisando" }
        ];

        function switchTab(id) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
            document.getElementById('nav-' + id).classList.add('active');
            document.getElementById('tab-' + id).classList.add('active');
            
            const titles = { dashboard: "Panel General", staff: "Equipo Humano", recambios: "Almacén Recambios", ordenes: "Órdenes de Trabajo", registros: "Control H / KM" };
            document.getElementById('tab-title').innerText = titles[id];
            
            if (id === 'staff') renderStaff('all');
            if (id === 'ordenes') renderOrders();
            if (id === 'registros') renderRegistros();
        }

        function renderStaff(role) {
            const grid = document.getElementById('staff-grid');
            grid.innerHTML = '';
            staff.filter(s => role === 'all' || s.r === role).forEach(s => {
                grid.innerHTML += `
                    <div class="bg-white p-6 rounded-[3rem] card-shadow border hover:border-amber-500 transition-all flex flex-col items-center">
                        <div class="w-full h-48 rounded-[2rem] mb-6 machine-draw flex items-center justify-center p-4">
                            ${machineIcons[s.type] || machineIcons.retro}
                        </div>
                        <h4 class="text-xl font-black uppercase tracking-tighter italic text-center text-zinc-800">${s.n}</h4>
                        <p class="text-[9px] font-black text-amber-500 uppercase tracking-widest mb-4">${s.r}</p>
                        <div class="w-full bg-slate-50 p-4 rounded-2xl text-center border shadow-inner">
                            <p class="text-[10px] font-bold text-zinc-400 uppercase mb-1 italic tracking-tighter">${s.m}</p>
                            <span class="text-[9px] font-black text-green-600 uppercase">Status: ${s.status}</span>
                        </div>
                    </div>
                `;
            });
        }

        function renderOrders() {
            const container = document.getElementById('ordenes-list');
            container.innerHTML = '';
            staff.forEach((s, index) => {
                const borderClass = s.status.includes('Parada') ? 'border-red-500 bg-red-50/20' : 'border-slate-100';
                container.innerHTML += `
                    <div class="bg-white p-8 rounded-[2.5rem] card-shadow border-2 ${borderClass} relative overflow-hidden group hover:scale-[1.01] transition-transform">
                        <div class="flex flex-col md:flex-row justify-between gap-6">
                            <div class="space-y-3 flex-1">
                                <div class="flex items-center gap-4">
                                    <span class="bg-black text-amber-500 px-4 py-1 rounded-full font-black text-[9px] uppercase tracking-widest italic shadow-lg">ID #${1024 + index}</span>
                                    <span class="text-zinc-500 text-[9px] font-black uppercase tracking-widest italic">${s.m}</span>
                                </div>
                                <h4 class="text-xl font-black italic tracking-tighter text-zinc-900 leading-tight">${s.ot}</h4>
                                <p class="text-xs font-bold text-zinc-500 flex items-center gap-2"><i class="fa-solid fa-user-gear text-amber-500"></i> Operario: <span class="text-black uppercase tracking-tight">${s.n}</span></p>
                            </div>
                            <div class="flex flex-col justify-between items-end">
                                <span class="bg-white text-zinc-900 px-4 py-1.5 rounded-xl text-[9px] font-black uppercase border-2 border-zinc-100 tracking-widest shadow-sm">${s.status}</span>
                                <button class="bg-black text-white p-4 rounded-2xl hover:bg-amber-500 hover:text-black transition-all shadow-xl"><i class="fa-solid fa-pen-to-square"></i></button>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        function renderRegistros() {
            const body = document.getElementById('registros-table-body');
            body.innerHTML = `
                <tr class="hover:bg-amber-50/50 transition-colors">
                    <td class="px-10 py-8 border-r border-slate-100">
                        <p class="font-black text-xl tracking-tight">Ricardo Gómez</p>
                        <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest italic">Unidad: CAT 320 (E1)</p>
                    </td>
                    <td class="px-10 py-8 font-mono text-2xl font-black text-blue-600 tracking-tighter italic">1.240,50 H</td>
                    <td class="px-10 py-8 font-mono text-2xl font-black text-red-600 border-l border-slate-100 tracking-tighter italic">1.248,00 H</td>
                    <td class="px-10 py-8 font-black text-3xl text-zinc-900 italic tracking-tighter">7,50 H</td>
                </tr>
                <tr class="hover:bg-amber-50/50 transition-colors">
                    <td class="px-10 py-8 border-r border-slate-100">
                        <p class="font-black text-xl tracking-tight">Luis Martínez</p>
                        <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest italic">Unidad: Volvo FH16 (C1)</p>
                    </td>
                    <td class="px-10 py-8 font-mono text-2xl font-black text-blue-600 tracking-tighter italic">45.230 KM</td>
                    <td class="px-10 py-8 font-mono text-2xl font-black text-red-600 border-l border-slate-100 tracking-tighter italic">45.420 KM</td>
                    <td class="px-10 py-8 font-black text-3xl text-zinc-900 italic tracking-tighter">190 KM</td>
                </tr>
            `;
        }

        function filterStaff(role) {
            renderStaff(role);
        }

        function openModal() { document.getElementById('modal-form').classList.remove('hidden'); }
        function closeModal() { document.getElementById('modal-form').classList.add('hidden'); }
        window.onload = () => switchTab('dashboard');
    </script>
</body>
</html>